import os
import json
Import('qt_env', 'arch', 'common', 'messaging', 'visionipc', 'transformations')

# ThorVG v1.0.4 — SharedLibrary: GL 심볼 격리, GPU+CPU 엔진
thorvg_src = [
  "#third_party/thorvg/src/common/tvgColor.cpp",
  "#third_party/thorvg/src/common/tvgCompressor.cpp",
  "#third_party/thorvg/src/common/tvgMath.cpp",
  "#third_party/thorvg/src/common/tvgStr.cpp",
  "#third_party/thorvg/src/renderer/tvgAccessor.cpp",
  "#third_party/thorvg/src/renderer/tvgAnimation.cpp",
  "#third_party/thorvg/src/renderer/tvgCanvas.cpp",
  "#third_party/thorvg/src/renderer/tvgFill.cpp",
  "#third_party/thorvg/src/renderer/tvgInitializer.cpp",
  "#third_party/thorvg/src/renderer/tvgLoaderMgr.cpp",
  "#third_party/thorvg/src/renderer/tvgPaint.cpp",
  "#third_party/thorvg/src/renderer/tvgPicture.cpp",
  "#third_party/thorvg/src/renderer/tvgRender.cpp",
  "#third_party/thorvg/src/renderer/tvgSaver.cpp",
  "#third_party/thorvg/src/renderer/tvgScene.cpp",
  "#third_party/thorvg/src/renderer/tvgShape.cpp",
  "#third_party/thorvg/src/renderer/tvgTaskScheduler.cpp",
  "#third_party/thorvg/src/renderer/tvgText.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/tvgGpuCommon.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGl.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlEffect.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlGeometry.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlGpuBuffer.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlTextureMgr.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlProgram.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlRenderer.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlSolidBatch.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlRenderPass.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlRenderTarget.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlRenderTask.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlShader.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlShaderSrc.cpp",
  "#third_party/thorvg/src/renderer/gpu_engine/gl/tvgGlTessellator.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwFill.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwImage.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwMath.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwMemPool.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwPostEffect.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwRaster.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwRenderer.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwRle.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwShape.cpp",
  "#third_party/thorvg/src/renderer/cpu_engine/tvgSwStroke.cpp",
  "#third_party/thorvg/src/loaders/raw/tvgRawLoader.cpp",
]

tvg_env = qt_env.Clone()
for flag_var in ['CXXFLAGS', 'CCFLAGS', 'CFLAGS']:
    if flag_var in tvg_env:
        tvg_env[flag_var] = [f for f in tvg_env[flag_var] if f not in ['-Werror', '-Wshadow']]
tvg_env.Append(CXXFLAGS=['-Wno-shadow', '-Wno-error', '-Wno-unused-variable', '-Wno-unused-parameter',
                          '-DTHORVG_GL_TARGET_GLES=1', '-fvisibility=hidden'])
tvg_env.Append(LINKFLAGS=['-Wl,-Bsymbolic'])
tvg_env['CPPPATH'] = list(tvg_env.get('CPPPATH', [])) + [
  '#third_party/thorvg/inc',
  '#third_party/thorvg/src/common',
  '#third_party/thorvg/src/renderer',
  '#third_party/thorvg/src/renderer/cpu_engine',
  '#third_party/thorvg/src/renderer/gpu_engine',
  '#third_party/thorvg/src/renderer/gpu_engine/gl',
  '#third_party/thorvg/src/loaders/raw',
]
thorvg_lib = tvg_env.SharedLibrary("thorvg", thorvg_src)

base_libs = [common, messaging, visionipc, transformations,
             'm', 'OpenCL', 'ssl', 'crypto', 'pthread', 'OmxCore', 'avformat', 'avcodec', 'avutil', 'yuv'] + qt_env["LIBS"]

if arch == 'larch64':
  base_libs.append('EGL')

maps = arch in ['larch64', 'aarch64', 'x86_64']

if arch == "Darwin":
  del base_libs[base_libs.index('OpenCL')]
  qt_env['FRAMEWORKS'] += ['OpenCL']

# FIXME: remove this once we're on 5.15 (24.04)
qt_env['CXXFLAGS'] += ["-Wno-deprecated-declarations"]

qt_util = qt_env.Library("qt_util", ["#selfdrive/ui/qt/api.cc", "#selfdrive/ui/qt/util.cc"], LIBS=base_libs)
widgets_src = ["qt/widgets/input.cc", "qt/widgets/wifi.cc", "qt/prime_state.cc",
               "qt/widgets/ssh_keys.cc", "qt/widgets/toggle.cc", "qt/widgets/controls.cc",
               "qt/widgets/offroad_alerts.cc", "qt/widgets/prime.cc", "qt/widgets/keyboard.cc",
               "qt/widgets/scrollview.cc", "qt/widgets/cameraview.cc", "#third_party/qrcode/QrCode.cc",
               "qt/request_repeater.cc", "qt/qt_window.cc", "qt/network/networking.cc", "qt/network/wifi_manager.cc"]

qt_env['CPPDEFINES'] = []
if maps:
  base_libs += ['QMapLibre']
  widgets_src += ["qt/maps/map_helpers.cc", "qt/maps/map_settings.cc", "qt/maps/map.cc", "qt/maps/map_panel.cc",
                  "qt/maps/map_eta.cc", "qt/maps/map_instructions.cc"]
  qt_env['CPPDEFINES'] += ["ENABLE_MAPS"]

widgets = qt_env.Library("qt_widgets", widgets_src, LIBS=base_libs)
Export('widgets')
qt_libs = [widgets, qt_util] + base_libs

# ThorVG 헤더 경로 (carrot_tvg.cc에서 #include <thorvg.h> 용)
qt_env['CPPPATH'] += [
  '#third_party/thorvg/inc',
]

qt_src = ["main.cc", "ui.cc", "qt/sidebar.cc", "qt/body.cc",
          "qt/window.cc", "qt/home.cc", "qt/offroad/settings.cc",
          "qt/offroad/software_settings.cc", "qt/offroad/developer_panel.cc", "qt/offroad/onboarding.cc",
          "qt/offroad/driverview.cc", "qt/offroad/experimental_mode.cc", "qt/offroad/firehose.cc",
          "qt/onroad/onroad_home.cc", "qt/onroad/annotated_camera.cc", "qt/onroad/model.cc",
          "carrot.cc",
          "carrot_tvg.cc",
          "qt/screenrecorder/screenrecorder.cc",
          "qt/screenrecorder/omx_encoder.cc",
          "#third_party/nanovg/nanovg.c",
          "qt/onroad/buttons.cc", "qt/onroad/alerts.cc", "qt/onroad/driver_monitoring.cc", "qt/onroad/hud.cc"]

def is_running_on_wsl2():
  try:
    with open('/proc/version', 'r') as f:
      contents = f.read()
      return 'WSL2' in contents or 'Ubuntu' in contents
  except FileNotFoundError:
    return False

if is_running_on_wsl2():
  qt_env.Append(CXXFLAGS=['-DWSL2'])
  base_libs.remove('OmxCore')
  qt_libs.remove('OmxCore')
  qt_src.remove("qt/screenrecorder/screenrecorder.cc")
  qt_src.remove("qt/screenrecorder/omx_encoder.cc")
  print("Building for WSL2. Removing Screen Recorder")

# build translation files
with open(File("translations/languages.json").abspath) as f:
  languages = json.loads(f.read())
translation_sources = [f"#selfdrive/ui/translations/{l}.ts" for l in languages.values()]
translation_targets = [src.replace(".ts", ".qm") for src in translation_sources]
lrelease_bin = 'third_party/qt5/larch64/bin/lrelease' if arch == 'larch64' else 'lrelease'

lupdate = qt_env.Command(translation_sources + ["translations/alerts_generated.h"], qt_src + widgets_src, "selfdrive/ui/update_translations.py")
lrelease = qt_env.Command(translation_targets, translation_sources, f"{lrelease_bin} $SOURCES")
qt_env.Depends(lrelease, lupdate)
qt_env.NoClean(translation_sources)
qt_env.Precious(translation_sources)
qt_env.NoCache(lupdate)

# create qrc file for compiled translations to include with assets
translations_assets_src = "#selfdrive/assets/translations_assets.qrc"
with open(File(translations_assets_src).abspath, 'w') as f:
  f.write('<!DOCTYPE RCC><RCC version="1.0">\n<qresource>\n')
  f.write('\n'.join([f'<file alias="{l}">../ui/translations/{l}.qm</file>' for l in languages.values()]))
  f.write('\n</qresource>\n</RCC>')

# build assets
assets = "#selfdrive/assets/assets.cc"
assets_src = "#selfdrive/assets/assets.qrc"
qt_env.Command(assets, [assets_src, translations_assets_src], f"rcc $SOURCES -o $TARGET")
qt_env.Depends(assets, Glob('#selfdrive/assets/*', exclude=[assets, assets_src, translations_assets_src, "#selfdrive/assets/assets.o"]) + [lrelease])
asset_obj = qt_env.Object("assets", assets)

# build main UI
qt_env.Program("ui", qt_src + [asset_obj], LIBS=qt_libs + [thorvg_lib])
if GetOption('extras'):
  qt_src.remove("main.cc")  # replaced by test_runner
  qt_env.Program('tests/test_translations', [asset_obj, 'tests/test_runner.cc', 'tests/test_translations.cc'] + qt_src, LIBS=qt_libs)

qt_env['CPPPATH'] += ["qt/screenrecorder/openmax/include/"]

if GetOption('extras'):
  qt_env.SharedLibrary("qt/python_helpers", ["qt/qt_window.cc"], LIBS=qt_libs)

  # spinner and text window
  qt_env.Program("_text", ["qt/text.cc"], LIBS=qt_libs)
  qt_env.Program("_spinner", ["qt/spinner.cc"], LIBS=qt_libs)

  # setup and factory resetter
  qt_env.Program("qt/setup/reset", ["qt/setup/reset.cc"], LIBS=qt_libs)
  qt_env.Program("qt/setup/setup", ["qt/setup/setup.cc", asset_obj],
                 LIBS=qt_libs + ['curl', 'common'])

  # build updater UI
  qt_env.Program("qt/setup/updater", ["qt/setup/updater.cc", asset_obj], LIBS=qt_libs)

  if arch != "Darwin":
    # build installers
    senv = qt_env.Clone()
    senv['LINKFLAGS'].append('-Wl,-strip-debug')

    release = "release3"
    installers = [
      ("openpilot", release),
      ("openpilot_test", f"{release}-staging"),
      ("openpilot_nightly", "nightly"),
      ("openpilot_internal", "nightly-dev"),
    ]

    cont = senv.Command(f"installer/continue_openpilot.o", f"installer/continue_openpilot.sh",
                        "ld -r -b binary -o $TARGET $SOURCE")
    for name, branch in installers:
      d = {'BRANCH': f"'\"{branch}\"'"}
      if "internal" in name:
        d['INTERNAL'] = "1"

      obj = senv.Object(f"installer/installers/installer_{name}.o", ["installer/installer.cc"], CPPDEFINES=d)
      f = senv.Program(f"installer/installers/installer_{name}", [obj, cont], LIBS=qt_libs)
      # keep installers small
      assert f[0].get_size() < 370*1e3

# build watch3
if arch in ['x86_64', 'aarch64', 'Darwin'] or GetOption('extras'):
  qt_env.Program("watch3", ["watch3.cc"], LIBS=qt_libs + ['common', 'msgq', 'visionipc'])
